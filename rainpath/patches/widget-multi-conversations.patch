+++ b/app/javascript/widget/store/modules/specs/conversationList/mutations.spec.js
@@ -0,0 +1,126 @@
+import { mutations } from '../../conversationList';
+
+describe('#mutations', () => {
+  describe('#setRecords', () => {
+    it('replaces the list with the first page', () => {
+      const state = {
+        records: [{ id: 9 }],
+        page: 2,
+        hasNextPage: true,
+        unreadCount: 0,
+      };
+      mutations.setRecords(state, {
+        payload: [{ id: 2 }, { id: 1 }],
+        page: 1,
+        hasNextPage: false,
+        unreadCount: 1,
+      });
+      expect(state).toEqual({
+        records: [{ id: 2 }, { id: 1 }],
+        page: 1,
+        hasNextPage: false,
+        unreadCount: 1,
+      });
+    });
+
+    it('appends later pages without repeating conversations already listed', () => {
+      const state = { records: [{ id: 3 }, { id: 2 }], page: 1 };
+      mutations.setRecords(state, {
+        payload: [{ id: 2 }, { id: 1 }],
+        page: 2,
+        hasNextPage: false,
+      });
+      expect(state.records).toEqual([{ id: 3 }, { id: 2 }, { id: 1 }]);
+      expect(state.page).toBe(2);
+    });
+  });
+
+  describe('#setLastMessage', () => {
+    it('shows the message on its row and moves the row to the top', () => {
+      const state = {
+        records: [
+          { id: 3, last_message: { id: 30 } },
+          { id: 2, last_message: { id: 20 }, last_activity_at: 1 },
+        ],
+      };
+      mutations.setLastMessage(state, {
+        id: 40,
+        conversation_id: 2,
+        created_at: 9,
+      });
+      expect(state.records.map(record => record.id)).toEqual([2, 3]);
+      expect(state.records[0].last_message.id).toBe(40);
+      expect(state.records[0].last_activity_at).toBe(9);
+    });
+
+    it('counts an agent reply as unread for its conversation', () => {
+      const state = {
+        records: [{ id: 2, last_message: { id: 20 }, unread_count: 0 }],
+        unreadCount: 0,
+      };
+      mutations.setLastMessage(state, {
+        id: 40,
+        conversation_id: 2,
+        message_type: 1,
+      });
+      expect(state.records[0].unread_count).toBe(1);
+      expect(state.unreadCount).toBe(1);
+    });
+
+    it('keeps a newer preview and ignores unknown conversations', () => {
+      const state = { records: [{ id: 2, last_message: { id: 40 } }] };
+      mutations.setLastMessage(state, { id: 30, conversation_id: 2 });
+      mutations.setLastMessage(state, { id: 50, conversation_id: 9 });
+      expect(state.records).toEqual([{ id: 2, last_message: { id: 40 } }]);
+    });
+  });
+
+  describe('#switchThread', () => {
+    it('moves to the next thread', () => {
+      const state = { thread: 1 };
+      mutations.switchThread(state);
+      expect(state.thread).toBe(2);
+    });
+  });
+
+  describe('#switchIdentity', () => {
+    it('moves to the next identity and forgets the previous visitor list', () => {
+      const state = {
+        identity: 1,
+        records: [{ id: 1, unread_count: 4 }],
+        page: 2,
+        hasNextPage: true,
+        unreadCount: 1,
+        uiFlags: { isFetching: true },
+      };
+      mutations.switchIdentity(state);
+      expect(state).toEqual({
+        identity: 2,
+        records: [],
+        page: 0,
+        hasNextPage: false,
+        unreadCount: 0,
+        uiFlags: { isFetching: false },
+      });
+    });
+  });
+
+  describe('#markRead', () => {
+    it('clears the conversation and drops it from the unread total once', () => {
+      const state = { records: [{ id: 1, unread_count: 4 }], unreadCount: 2 };
+      mutations.markRead(state, 1);
+      mutations.markRead(state, 1);
+      mutations.markRead(state, 2);
+      expect(state.records).toEqual([{ id: 1, unread_count: 0 }]);
+      expect(state.unreadCount).toBe(1);
+    });
+  });
+
+  describe('#setFetching', () => {
+    it('sets the loading flag', () => {
+      const state = { uiFlags: { isFetching: false } };
+      mutations.setFetching(state, true);
+      expect(state.uiFlags.isFetching).toBe(true);
+    });
+  });
+});
diff --git a/app/javascript/widget/store/modules/specs/conversationList/reconnect.spec.js b/app/javascript/widget/store/modules/specs/conversationList/reconnect.spec.js
new file mode 100644
index 0000000000000000000000000000000000000000..a97a9169eae1ed445396b34c5885c52a95f3fcf8
--- /dev/null
+++ b/app/javascript/widget/store/modules/specs/conversationList/reconnect.spec.js
@@ -0,0 +1,113 @@
+import { createStore } from 'vuex';
+import { API } from 'widget/helpers/axios';
+import conversation from '../../conversation';
+import conversationAttributes from '../../conversationAttributes';
+import conversationList from '../../conversationList';
+
+vi.mock('widget/helpers/axios');
+
+const fresh = module => ({ ...module, state: structuredClone(module.state) });
+
+const buildStore = () =>
+  createStore({
+    modules: {
+      conversation: fresh(conversation),
+      conversationAttributes: fresh(conversationAttributes),
+      conversationList: fresh(conversationList),
+    },
+  });
+
+// Conversation 1 is on screen with message 100; conversation 2 is older and holds message 50.
+const olderMessage = {
+  id: 50,
+  conversation_id: 2,
+  created_at: 5,
+  content: 'Bonjour',
+};
+
+const isMessagesRequest = url => url.startsWith('/api/v1/widget/messages');
+
+// Like the server: `after` returns only newer messages of the requested conversation.
+const serveOlderConversation = (url, { params } = {}) => {
+  if (!isMessagesRequest(url)) return new Promise(() => {});
+  const payload = params?.after >= olderMessage.id ? [] : [olderMessage];
+  return Promise.resolve({ data: { payload, meta: {} } });
+};
+
+const goOffline = () =>
+  API.get.mockImplementation(url =>
+    isMessagesRequest(url)
+      ? Promise.reject(new Error('Network Error'))
+      : new Promise(() => {})
+  );
+
+const shownMessageIds = store =>
+  Object.keys(store.getters['conversation/getConversation']).map(Number);
+
+describe('switching conversations while offline', () => {
+  let store;
+
+  beforeEach(() => {
+    window.chatwootWebChannel = { enabledFeatures: ['multiple_conversations'] };
+    store = buildStore();
+    store.commit('conversationList/setRecords', {
+      payload: [
+        { id: 1, status: 'open', unread_count: 0 },
+        { id: 2, status: 'open', unread_count: 0 },
+      ],
+      page: 1,
+      hasNextPage: false,
+      unreadCount: 0,
+    });
+    store.commit('conversationAttributes/SET_CONVERSATION_ATTRIBUTES', {
+      id: 1,
+    });
+    store.commit('conversation/setMessagesInConversation', [
+      { id: 100, conversation_id: 1, created_at: 10, content: 'Merci' },
+    ]);
+  });
+
+  afterEach(() => {
+    delete window.chatwootWebChannel;
+  });
+
+  it('catches up on the conversation opened offline once the socket reconnects', async () => {
+    // The socket drops while conversation 1 is on screen.
+    await store.dispatch('conversation/setLastMessageId');
+    goOffline();
+    await store.dispatch('conversationList/open', 2);
+    expect(shownMessageIds(store)).toEqual([]);
+
+    API.get.mockImplementation(serveOlderConversation);
+    await store.dispatch('conversation/syncLatestMessages');
+
+    expect(shownMessageIds(store)).toEqual([50]);
+  });
+
+  it('loads the conversation again when it is reopened after a failed load', async () => {
+    goOffline();
+    await store.dispatch('conversationList/open', 2);
+    expect(shownMessageIds(store)).toEqual([]);
+
+    API.get.mockImplementation(serveOlderConversation);
+    await store.dispatch('conversationList/open', 2);
+
+    expect(shownMessageIds(store)).toEqual([50]);
+  });
+
+  it('never reuses a cursor recorded in another conversation', async () => {
+    goOffline();
+    await store.dispatch('conversationList/open', 2);
+    // A disconnect noticed late records the cursor while conversation 2 is still empty.
+    await store.dispatch('conversation/setLastMessageId');
+
+    API.get.mockImplementation(serveOlderConversation);
+    await store.dispatch('conversation/syncLatestMessages');
+
+    expect(API.get).toHaveBeenLastCalledWith(
+      expect.stringContaining('/api/v1/widget/messages'),
+      { params: { before: undefined, after: null } }
+    );
+    expect(shownMessageIds(store)).toEqual([50]);
+  });
+});
