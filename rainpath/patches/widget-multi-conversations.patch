+      });
+
+      await actions.load({ state, dispatch });
+
+      expect(dispatch).not.toBeCalledWith('open', 2);
+    });
+  });
+
+  describe('#open', () => {
+    it('clears the thread on screen, attaches the selected conversation and loads it', async () => {
